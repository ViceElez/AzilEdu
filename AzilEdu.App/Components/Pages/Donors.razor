@page "/donors"
@rendermode InteractiveServer
@using AzilEdu.Shared.DTOs.Donors
@using System.Net.Http.Json
@inject HttpClient Http

<MudText Typo="Typo.h4" GutterBottom="true">Donatori</MudText>
<MudText Typo="Typo.body1" Class="mb-4">
    Na ovoj stranici prikazujemo donatore koji dolaze iz baze preko API-ja i DTO objekata.
</MudText>

<MudTable Items="@donors"
          Hover="true"
          Striped="true"
          Bordered="true"
          Dense="true">
    <HeaderContent>
        <MudTh><MudTableSortLabel SortBy="new Func<DonorDto, object>(x => x.FirstName)">Ime</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<DonorDto, object>(x => x.LastName)">Prezime</MudTableSortLabel></MudTh>
        <MudTh>Organizacija</MudTh>
        <MudTh>Email</MudTh>
        <MudTh>Telefon</MudTh>
        <MudTh>Grad</MudTh>
        <MudTh>Tip</MudTh>
        <MudTh>Status</MudTh>
        <MudTh><MudTableSortLabel SortBy="new Func<DonorDto, object>(x => x.CreatedAt)">Datum kreiranja</MudTableSortLabel></MudTh>
    </HeaderContent>

    <RowTemplate>
        <MudTd DataLabel="Ime">@context.FirstName</MudTd>
        <MudTd DataLabel="Prezime">@context.LastName</MudTd>
        <MudTd DataLabel="Organizacija">@context.OrganizationName</MudTd>
        <MudTd DataLabel="Email">@context.Email</MudTd>
        <MudTd DataLabel="Telefon">@context.PhoneNumber</MudTd>
        <MudTd DataLabel="Grad">@context.City</MudTd>
        <MudTd DataLabel="Tip">@context.TypeName</MudTd>
        <MudTd DataLabel="Status">
            <MudChip T="string" Color="@GetStatusColor(context.StatusName)">
                @context.StatusName
            </MudChip>
        </MudTd>
        <MudTd DataLabel="Datum kreiranja">@context.CreatedAt.ToShortDateString()</MudTd>
    </RowTemplate>

    <NoRecordsContent>
        <MudText Typo="Typo.body1" Class="pa-4">
            Nema podataka za prikaz.
        </MudText>
    </NoRecordsContent>
</MudTable>

@code {
    private List<DonorDto> donors = new();

    protected override async Task OnInitializedAsync()
    {
        donors = await Http.GetFromJsonAsync<List<DonorDto>>("api/donors") ?? new();
    }

    private Color GetStatusColor(string status)
    {
        return status switch
        {
            "Aktivan" => Color.Success,
            "Neaktivan" => Color.Default,
            _ => Color.Default
        };
    }
}