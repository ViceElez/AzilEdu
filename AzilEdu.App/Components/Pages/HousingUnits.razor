@page "/housing-units"
@rendermode InteractiveServer
@using AzilEdu.Shared.Models
@using System.Net.Http.Json
@inject HttpClient Http

<MudText Typo="Typo.h4" GutterBottom="true">Smještajne jedinice</MudText>
<MudText Typo="Typo.body1" Class="mb-4">
    Prikazujemo smještajne jedinice koje dolaze iz SQLite baze preko API projekta.
</MudText>

<MudGrid Class="mt-4" style="display: flex; align-items: stretch;"> 
    <MudItem xs="12" md="3" style="display: flex;">
        <MudPaper Class="pa-4 h-100" Elevation="2">
            <MudText Typo="Typo.h6">Ukupan broj smještajnih jedinica:@CountOfAllHousingUnits</MudText>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="3" style="display: flex;">
        <MudPaper Class="pa-4 h-100" Elevation="2">
            <MudText Typo="Typo.h6">Ukupan broj aktivnih jedinica:@CountOfActiveUnits</MudText>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="3" style="display: flex;">
        <MudPaper Class="pa-4 h-100" Elevation="2">
            <MudText Typo="Typo.h6">Ukupni broj punih jedinica:@CountOfFullUnits</MudText>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="3" style="display: flex;">
        <MudPaper Class="pa-4 h-100" Elevation="2">
            <MudText Typo="Typo.h6">Ukupan broj slobodnih kapaciteta:@CountOfFreeCapacity</MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

<MudButtonGroup Class="mt-4 d-flex justify-content-center">
    <MudButton OnClick="@(()=>SetStatus("Sve jedinice"))">
        Sve jedinice
    </MudButton>
    <MudButton OnClick="@(()=>SetStatus("Aktivne"))">
        Aktivne
    </MudButton>
    <MudButton OnClick="@(()=>SetStatus("Pune"))">
        Pune
    </MudButton>
    <MudButton OnClick="@(()=>SetStatus("Slobodne"))">
        Sa slobodnim mjestima
    </MudButton>
</MudButtonGroup>

<MudTable Items="@FilteredHousing" Hover="true" Striped="true" Bordered="true" Dense="true">
    <HeaderContent>
        <MudTh>Slika</MudTh>
        <MudTh>Naziv</MudTh>
        <MudTh>Tip jedinice</MudTh>
        <MudTh>Kapacitet</MudTh>
        <MudTh>Zauzeto</MudTh>
        <MudTh>Slobodno</MudTh>
        <MudTh>Zadnje čišćenje</MudTh>
        <MudTh>Status</MudTh>
    </HeaderContent>

    <RowTemplate>
        <MudTd DataLabel="Slika">
            <MudAvatar Size="Size.Large">
                <MudImage Src="@context.ImageUrl" Alt="@context.Name"/>
            </MudAvatar>
        </MudTd>
        <MudTd DataLabel="Naziv">@context.Name</MudTd>
        <MudTd DataLabel="Tip jedinice">@context.UnitType</MudTd>
        <MudTd DataLabel="Kapacitet">@context.Capacity</MudTd>
        <MudTd DataLabel="Zauzeto">@context.Occupied</MudTd>
        <MudTd DataLabel="Slobodno">@GetFreeCapacity(context)</MudTd>
        <MudTd DataLabel="Zadnje čišćenje">@GetLatestCleanedText(context)</MudTd>
        <MudTd DataLabel="Status">
            <MudChip T="string"
                     Color="@GetHousingUnitColor(context)"
                     Variant="Variant.Filled">
                @GetHousingUnitStatusText(context)
            </MudChip>
        </MudTd>
    </RowTemplate>
</MudTable>

@code {
    private List<HousingUnit> Housings = new();

    protected override async Task OnInitializedAsync()
    {
        List<HousingUnit>? result = await Http.GetFromJsonAsync<List<HousingUnit>>("api/housingunit");
        Housings = result ?? new List<HousingUnit>();
    }

    private string selectedStatus = "Sve jedinice";

    private int CountOfAllHousingUnits => Housings.Count;

    private int CountOfActiveUnits => Housings.Count(h => h.IsActive);

    private int CountOfFullUnits => Housings.Count(h => h.Occupied >= h.Capacity);
 
    private int CountOfFreeCapacity => Housings.Sum(h => GetFreeCapacity(h));

    private IEnumerable<HousingUnit> FilteredHousing =>
    selectedStatus switch
    {
        "Aktivne" => Housings.Where(h => h.IsActive),
        "Pune" => Housings.Where(h => h.Occupied >= h.Capacity),
        "Slobodne" => Housings.Where(h => h.Occupied < h.Capacity && h.IsActive),
        _ => Housings
    };

    private void SetStatus(string status)
    {
        selectedStatus = status;
    }

    private int GetFreeCapacity(HousingUnit unit)
    {
        return unit.Capacity - unit.Occupied;
    }

    private string GetLatestCleanedText(HousingUnit unit)
    {
        return unit.LastCleanedAt?.ToString("dd.MM.yyyy HH:mm") ?? "Nema podatka";
    }

    private string GetHousingUnitStatusText(HousingUnit unit)
    {
        int freeCapacity = GetFreeCapacity(unit);
        if (freeCapacity <= 0)
        {
            return "Puna";
        }
        return unit.IsActive ? "Aktivna" : "Neaktivna";
    }

    private Color GetHousingUnitColor(HousingUnit unit)
    {
        int freeCapacity = GetFreeCapacity(unit);
        if (freeCapacity <= 0)
        {
            return Color.Error;
        }
        return unit.IsActive ? Color.Success : Color.Warning;
    }

}