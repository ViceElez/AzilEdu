@page "/"

<PageTitle>Azil za životinje</PageTitle>

<header>
    Dobro došli! u @applicationName
</header>

<section>
    <h3>
        @description
    </h3>
    <p>
       @status
    </p>
</section>

@code{
    string applicationName = "Azil za životinje";
    string description = "AzilEdu je aplikacija za upravljanje podacima o životinjama,vrstama, pasminama i udomljavanju.";
    string status = "U sljedećim lekcijama postupno ćemo dodavati nove funkcionalnosti i povezivati korisničko sučelje s API slojem.";
}