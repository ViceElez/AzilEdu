@page "/donors"
@rendermode InteractiveServer
@using AzilEdu.Shared.DTOs.Donors
@using System.Net.Http.Json
@using AzilEdu.Shared.DTOs
@inject HttpClient Http
@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar

<MudText Typo="Typo.h4" GutterBottom="true">Donatori</MudText>
<MudText Typo="Typo.body1" Class="mb-4">
    Na ovoj stranici prikazujemo donatore koji dolaze iz baze preko API-ja i DTO objekata.
</MudText>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <MudAlert Severity="Severity.Error" Class="mb-4">
        @errorMessage
    </MudAlert>
}

<MudPaper Class="pa-4 mb-4">
    <MudGrid>
        <MudItem xs="12" md="3">
            <MudTextField Label="Pretraga"
                          @bind-Value="searchString"
                          Immediate="true" />
        </MudItem>

        <MudItem xs="12" md="3">
            <MudSelect T="int?" Label="Status"
                       @bind-Value="selectedStatusId"
                       Clearable="true">
                @foreach (var status in statuses)
                {
                    <MudSelectItem T="int?" Value="@((int?)status.Id)">
                        @status.Name
                    </MudSelectItem>
                }
            </MudSelect>
        </MudItem>

        <MudItem xs="12" md="3">
            <MudSelect T="int?" Label="Tip"
                       @bind-Value="selectedTypeId"
                       Clearable="true">
                @foreach (var type in types)
                {
                    <MudSelectItem T="int?" Value="@((int?)type.Id)">
                        @type.Name
                    </MudSelectItem>
                }
            </MudSelect>
        </MudItem>
    </MudGrid>

    <MudStack Row="true" Spacing="2" Class="mt-4">
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="LoadTasks">
            Primijeni filtere
        </MudButton>

        <MudButton Variant="Variant.Outlined"
                   Color="Color.Secondary"
                   OnClick="ResetFilters">
            Reset filtera
        </MudButton>
    </MudStack>
</MudPaper>

<MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/donors/create" Class="mb-4">
    Novi donator
</MudButton>

@if (isLoading)
{
    <div class="d-flex justify-center my-6">
        <MudProgressCircular Indeterminate="true"
        Color="Color.Primary" />
    </div>
}
else
{
    <MudTable Items="@FilteredDonors"
              Hover="true"
              Striped="true"
              Bordered="true"
              Dense="true">
        <HeaderContent>
            <MudTh><MudTableSortLabel SortBy="new Func<DonorDto, object>(x => x.FirstName)">Ime</MudTableSortLabel></MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<DonorDto, object>(x => x.LastName)">Prezime</MudTableSortLabel></MudTh>
            <MudTh>Organizacija</MudTh>
            <MudTh>Email</MudTh>
            <MudTh>Telefon</MudTh>
            <MudTh>Grad</MudTh>
            <MudTh>Tip</MudTh>
            <MudTh>Status</MudTh>
            <MudTh><MudTableSortLabel SortBy="new Func<DonorDto, object>(x => x.CreatedAt)">Datum kreiranja</MudTableSortLabel></MudTh>
            <MudTh>Akcije</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd DataLabel="Ime">@context.FirstName</MudTd>
            <MudTd DataLabel="Prezime">@context.LastName</MudTd>
            <MudTd DataLabel="Organizacija">@context.OrganizationName</MudTd>
            <MudTd DataLabel="Email">@context.Email</MudTd>
            <MudTd DataLabel="Telefon">@context.PhoneNumber</MudTd>
            <MudTd DataLabel="Grad">@context.City</MudTd>
            <MudTd DataLabel="Tip">@context.TypeName</MudTd>
            <MudTd DataLabel="Status">
                <MudChip T="string" Color="@GetStatusColor(context.StatusName)">
                    @context.StatusName
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Datum kreiranja">@context.CreatedAt.ToShortDateString()</MudTd>
            <MudTd DataLabel="Akcije">
                <MudButton Variant="Variant.Text" Color="Color.Primary" Href="@($"/donors/edit/{context.Id}")">
                    Uredi
                </MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="@(() => DeleteDonor(context.Id))">
                    Obriši
                </MudButton>
            </MudTd>
        </RowTemplate>

        <NoRecordsContent>
            <MudText Typo="Typo.body1" Class="pa-4">
                Nema podataka za prikaz.
            </MudText>
        </NoRecordsContent>
    </MudTable>
}
@code {
    private List<DonorDto> donors = new();
    private List<LookupDto> statuses = new();
    private List<LookupDto> types = new();

    private IEnumerable<DonorDto> FilteredDonors =>
        donors.Where(DonorMatchesSearch);

    private bool Matches(string? value) =>
    !string.IsNullOrEmpty(value) &&
    value.Contains(searchString, StringComparison.OrdinalIgnoreCase);

    private string errorMessage = string.Empty;
    private string searchString = string.Empty;
    private int? selectedStatusId;
    private int? selectedTypeId;
    private bool isLoading = true;


    private async Task LoadTasks()
    {
        isLoading = true;
        try
        {
            var query = new List<string>();

            if (selectedStatusId.HasValue)
                query.Add($"statusId={selectedStatusId.Value}");

            if (selectedTypeId.HasValue)
                query.Add($"typeId={selectedTypeId.Value}");

            var url = "api/donors";
            if (query.Count > 0)
                url += "?" + string.Join("&", query);

            donors = await Http.GetFromJsonAsync<List<DonorDto>>(url) ?? new();
        }
        catch (Exception ex)
        {
            errorMessage = $"Greška kod učitavanja donatora: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadStatusesAndTypes()
    {
        try
        {
            statuses = await Http.GetFromJsonAsync<List<LookupDto>>("api/donorstatuses") ?? new();
            types = await Http.GetFromJsonAsync<List<LookupDto>>("api/donortypes") ?? new();
        }
        catch (Exception ex)
        {
            errorMessage = $"Greška kod učitavanja statusa i tipova: {ex.Message}";
        }
    }

    private async Task ResetFilters()
    {
        searchString = string.Empty;
        selectedStatusId = null;
        selectedTypeId = null;
        await LoadTasks();
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadStatusesAndTypes();
        await LoadTasks();
    }

    private bool DonorMatchesSearch(DonorDto donor)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;

        return Matches(donor.FirstName)
            || Matches(donor.LastName)
            || Matches(donor.OrganizationName)
            || Matches(donor.Email);
    }

    private async Task DeleteDonor(int id)
    {
        bool confirmed = await JSRuntime.InvokeAsync<bool>(
            "confirm", "Jeste li sigurni da želite obrisati ovog donatora? Ova radnja se ne može poništiti.");

        if (!confirmed)
            return;

        try
        {
            var response = await Http.DeleteAsync($"api/donors/{id}");

            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add("Donatora nije moguće obrisati.", Severity.Error);
                return;
            }

            donors = donors.Where(d => d.Id != id).ToList();
            Snackbar.Add("Donator je uspješno obrisan.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Greška kod brisanja donatora: {ex.Message}", Severity.Error);
        }
    }

    private Color GetStatusColor(string status)
    {
        return status switch
        {
            "Aktivan" => Color.Success,
            "Neaktivan" => Color.Default,
            _ => Color.Default
        };
    }
}