@page "/species"

<MudText Typo="Typo.h1" Class="d-flex justify-content-center">
    Species
</MudText>

<MudText Typo="Typo.body1" Class="d-flex justify-content-center mt-2">
    Pregled svih vrsta evidentiranih u našem sustavu.
</MudText>

<MudGrid Class="mt-3 d-flex justify-content-start">
    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4 d-flex flex-column h-100" Elevation="2">
            <MudImage Src="images/dog.jpg"
                      Alt="Dog Image"
                      Fluid="true"
                      Style="height: 250px; width: 100%; object-fit: cover;"
                      Class="mb-3" />
            <MudText Typo="Typo.h5">
                Ime: Pas
            </MudText>
            <MudText Typo="Typo.h6">
                Lat. naziv: Canis lupus familiaris
            </MudText>
            <MudText Typo="Typo.body1">
                Opis: Domaća životinja poznata po odanosti i društvenosti. Često se koristi kao kućni ljubimac, radni ili terapijski pas.
            </MudText>
            <MudText Typo="Typo.body2">
                Životni vijek: 10–13 godina
            </MudText>
            <MudText Typo="Typo.body2">
                Prehrana: Svejed
            </MudText>
            <MudText Typo="Typo.body2">
                Broj jedinki u azilu: 15
            </MudText>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Class="mt-auto d-block mx-auto">
                Detalji
            </MudButton>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4 d-flex flex-column h-100" Elevation="2">
            <MudImage Src="images/seal.jpg"
                      Alt="Seal Image"
                      Fluid="true"
                      Style="height: 250px; width: 100%; object-fit: cover;"
                      Class="mb-3" />
            <MudText Typo="Typo.h5">
                Ime: Tuljan
            </MudText>
            <MudText Typo="Typo.h6">
                Lat. naziv: Phoca vitulina
            </MudText>
            <MudText Typo="Typo.body1">
                Opis: Morski sisavac prilagođen životu u vodi, poznat po svojoj spretnosti pri plivanju.
            </MudText>
            <MudText Typo="Typo.body2">
                Životni vijek: 20–30 godina
            </MudText>
            <MudText Typo="Typo.body2">
                Prehrana: Mesojed
            </MudText>
            <MudText Typo="Typo.body2">
                Broj jedinki u azilu: 8
            </MudText>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Class="mt-auto d-block mx-auto">
                Detalji
            </MudButton>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4 d-flex flex-column h-100" Elevation="2">
            <MudImage Src="images/squirrel.jpg"
                      Alt="Squirell Image"
                      Fluid="true"
                      Style="height: 250px; width: 100%; object-fit: cover;"
                      Class="mb-3" />
            <MudText Typo="Typo.h5">
                Ime: Vjeverica
            </MudText>
            <MudText Typo="Typo.h6">
                Lat. naziv: Sciurus vulgaris
            </MudText>
            <MudText Typo="Typo.body1">
                Opis: Mali glodavac prepoznatljiv po dugom repu i sposobnosti penjanja po drveću.
            </MudText>
            <MudText Typo="Typo.body2">
                Životni vijek: 5–10 godina
            </MudText>
            <MudText Typo="Typo.body2">
                Prehrana: Svejed
            </MudText>
            <MudText Typo="Typo.body2">
                Broj jedinki u azilu: 8
            </MudText>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Class="mt-auto d-block mx-auto">
                Detalji
            </MudButton>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4 d-flex flex-column h-100" Elevation="2">
            <MudImage Src="images/otter.jpg"
                      Alt="Otter Image"
                      Fluid="true"
                      Style="height: 250px; width: 100%; object-fit: cover;"
                      Class="mb-3" />
            <MudText Typo="Typo.h5">
                Ime: Vidra
            </MudText>
            <MudText Typo="Typo.h6">
                Lat. naziv: Lutra lutra
            </MudText>
            <MudText Typo="Typo.body1">
                Opis: Poluvodeni sisavac poznat po izvrsnom plivanju i gustom krznu koje ga štiti od hladnoće.
            </MudText>
            <MudText Typo="Typo.body2">
                Životni vijek: 10–15 godina
            </MudText>
            <MudText Typo="Typo.body2">
                Prehrana: Mesojed
            </MudText>
            <MudText Typo="Typo.body2">
                Broj jedinki u azilu: 3
            </MudText>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Class="mt-auto d-block mx-auto">
                Detalji
            </MudButton>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4 d-flex flex-column h-100" Elevation="2">
            <MudImage Src="images/sheep.jpg"
                      Alt="Sheep Image"
                      Fluid="true"
                      Style="height: 250px; width: 100%; object-fit: cover;"
                      Class="mb-3" />
            <MudText Typo="Typo.h5">
                Ime: Ovca
            </MudText>
            <MudText Typo="Typo.h6">
                Lat. naziv: Ovis aries
            </MudText>
            <MudText Typo="Typo.body1">
                Opis: Domaća životinja koja se uzgaja zbog vune, mesa i mlijeka. Živi u stadima.
            </MudText>
            <MudText Typo="Typo.body2">
                Životni vijek: 10–12 godina
            </MudText>
            <MudText Typo="Typo.body2">
                Prehrana: Biljojed
            </MudText>
            <MudText Typo="Typo.body2">
                Broj jedinki u azilu: 12
            </MudText>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Class="mt-auto d-block mx-auto">
                Detalji
            </MudButton>
        </MudPaper>
    </MudItem>
</MudGrid>



