@page "/donors/edit/{Id:int}"
@rendermode InteractiveServer
@using AzilEdu.Shared.DTOs.Donors
@using AzilEdu.Shared.DTOs
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<MudText Typo="Typo.h4" GutterBottom="true">Uredi donatora</MudText>
<MudText Typo="Typo.body1" Class="mb-4">
    Na ovoj stranici dohvaćamo postojeći zapis i spremamo promjene preko PUT zahtjeva.
</MudText>

<MudForm @ref="form">
    <MudStack Spacing="2">
        <MudTextField @bind-Value="model.FirstName" Label="Ime" Required="true" />
        <MudTextField @bind-Value="model.LastName" Label="Prezime" Required="true" />
        <MudTextField @bind-Value="model.OrganizationName" Label="Organizacija" />
        <MudTextField @bind-Value="model.Email" Label="E-mail" Required="true" />
        <MudTextField @bind-Value="model.PhoneNumber" Label="Telefon" />
        <MudTextField @bind-Value="model.Address" Label="Adresa" />
        <MudTextField @bind-Value="model.City" Label="Grad" />

        <MudSelect T="int"
                   Label="Tip donatora"
                   @bind-Value="model.DonorTypeId"
                   Variant="Variant.Outlined"
                   Required="true">
            @foreach (var type in typeList)
            {
                <MudSelectItem Value="@type.Id">@type.Name</MudSelectItem>
            }
        </MudSelect>

        <MudSelect T="int"
                   Label="Status"
                   @bind-Value="model.DonorStatusId"
                   Variant="Variant.Outlined"
                   Required="true">
            @foreach (var status in statusList)
            {
                <MudSelectItem Value="@status.Id">@status.Name</MudSelectItem>
            }
        </MudSelect>

        <MudTextField @bind-Value="model.Note" Label="Napomena" Lines="3" />

        <MudButton ButtonType="ButtonType.Button"
                   OnClick="@UpdateDonor"
                   Variant="Variant.Filled"
                   Color="Color.Primary">
            Spremi promjene
        </MudButton>
    </MudStack>
</MudForm>

@code {
    [Parameter] public int Id { get; set; }

    private MudForm? form;
    private SaveDonorDto model = new();

    private List<LookupDto> typeList = new();
    private List<LookupDto> statusList = new();

    protected override async Task OnInitializedAsync()
    {
        typeList = await Http.GetFromJsonAsync<List<LookupDto>>("api/donortypes") ?? new();
        statusList = await Http.GetFromJsonAsync<List<LookupDto>>("api/donorstatuses") ?? new();

        var donor = await Http.GetFromJsonAsync<DonorDto>($"api/donors/{Id}");

        if (donor is not null)
        {
            model = new SaveDonorDto
            {
                FirstName = donor.FirstName,
                LastName = donor.LastName,
                OrganizationName = donor.OrganizationName,
                Email = donor.Email,
                PhoneNumber = donor.PhoneNumber,
                Address = donor.Address,
                City = donor.City,
                Note = donor.Note,
                DonorTypeId = donor.DonorTypeId,
                DonorStatusId = donor.DonorStatusId
            };
        }

        if (model.DonorTypeId == 0 && typeList.Count > 0)
        {
            model.DonorTypeId = typeList[0].Id;
        }

        if (model.DonorStatusId == 0 && statusList.Count > 0)
        {
            model.DonorStatusId = statusList[0].Id;
        }
    }

    private async Task UpdateDonor()
    {
        if (form is not null)
        {
            await form.ValidateAsync();

            if (!form.IsValid)
            {
                return;
            }
        }

        try
        {
            var response = await Http.PutAsJsonAsync($"api/donors/{Id}", model);

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Promjene su uspješno spremljene.", Severity.Success);
                Navigation.NavigateTo("/donors");
                return;
            }

            Snackbar.Add("Promjene nisu spremljene.", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Greška kod spremanja promjena: {ex.Message}", Severity.Error);
        }
    }
}