@page "/animals"

<MudText Typo="Typo.h1" Class="d-flex justify-center" GutterBottom="true">
    Animals
</MudText>

<MudText Typo="Typo.body1" Class="d-flex justify-center mt-2">
    Pregled zivotinja u azilu
</MudText>

<MudPaper Class="pa-6 mud-theme-primary">
    <MudText Typo="Typo.h3">
        Zivotinje u azilu   
    </MudText>
</MudPaper>


<MudGrid Class="mt-3">
    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h6">Sve životinje</MudText>
            <MudText Typo="Typo.body2">
                Pregled svih životinja evidentiranih u azilu.
            </MudText>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h6">Vrste i pasmine</MudText>
            <MudText Typo="Typo.body2">
                Organizacija životinja prema vrstama i pasminama.
            </MudText>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4" Elevation="2">
            <MudText Typo="Typo.h6">Smještaj</MudText>
            <MudText Typo="Typo.body2">
                Pregled bokseva, kaveza i drugih smještajnih jedinica.
            </MudText> 
        </MudPaper>
    </MudItem>
</MudGrid>

<MudPaper Class="pa-4" Elevation="2">
    <MudText Typo="Typo.h6">Sve životinje</MudText>
    <MudText Typo="Typo.body2">
        Pregled svih životinja evidentiranih u azilu.
    </MudText>

    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               Class="mt-3">
        Otvori pregled
    </MudButton>
</MudPaper>


<MudPaper Class="pa-4" Elevation="2">
    <MudImage Src="images/seal.jpg"
              Alt="Životinje u azilu"
              Fluid="true"
              Class="mb-3" />

    <MudText Typo="Typo.h6" Class="d-flex justify-content-center">Housing units</MudText>
    <MudText Typo="Typo.body2" Class="d-flex justify-content-center">
        Pregled bokseva, kaveza i drugih smještajnih jedinica
    </MudText>

    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               Class="mt-3 d-block mx-auto">
        Otvori pregled
    </MudButton>
</MudPaper>

    
