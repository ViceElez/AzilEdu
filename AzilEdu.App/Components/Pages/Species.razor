@page "/species"

<MudText Typo="Typo.h1" Class="d-flex justify-content-center">
    Species
</MudText>

<MudText Typo="Typo.body1" Class="d-flex justify-content-center mt-2">
    Pregled svih vrsta evidentiranih u našem sustavu.
</MudText>

<MudGrid Class="mt-3 d-flex justify-content-start">
    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4" Elevation="2">
            <MudImage Src=""
                      Alt="Dog Image"
                      Fluid="true"
                      Class="mb-3" />
            <MudText Typo="Typo.h5">
                     Pas
            </MudText>
            <MudText Typo="Typo.h6">
                Canis lupus familiaris
            </MudText>
            <MudText Typo="Typo.body1">
                Domaća životinja poznata po odanosti i društvenosti. Često se koristi kao kućni ljubimac, radni ili terapijski pas.
            </MudText>
            <MudText Typo="Typo.body2">
                10–13 godina
            </MudText>
            <MudText Typo="Typo.body2">
                Svejed
            </MudText>
            <MudText Typo="Typo.body2">
                15
            </MudText>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Class="mt-3 d-block mx-auto">
                       Detalji
            </MudButton>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4" Elevation="2">
            <MudImage Src="images/seal.jpg"
                      Alt="Seal Image"
                      Fluid="true"
                      Class="mb-3" />
            <MudText Typo="Typo.h5">
                Tuljan
            </MudText>
            <MudText Typo="Typo.h6">
                Phoca vitulina
            </MudText>
            <MudText Typo="Typo.body1">
                Morski sisavac prilagođen životu u vodi, poznat po svojoj spretnosti pri plivanju.
            </MudText>
            <MudText Typo="Typo.body2">
                20–30 godina
            </MudText>
            <MudText Typo="Typo.body2">
                Mesojed
            </MudText>
            <MudText Typo="Typo.body2">
                8
            </MudText>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Class="mt-3">
                Detalji
            </MudButton>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4" Elevation="2">
            <MudImage Src=""
                      Alt="Squirell Image"
                      Fluid="true"
                      Class="mb-3"/>
            <MudText Typo="Typo.h5">
                      Vjeverica
            </MudText>
            <MudText Typo="Typo.h6">
                Sciurus vulgaris
            </MudText>
            <MudText Typo="Typo.body1">
                Mali glodavac prepoznatljiv po dugom repu i sposobnosti penjanja po drveću.
            </MudText>
            <MudText Typo="Typo.body2">
                5–10 godina
            </MudText>
            <MudText Typo="Typo.body2">
                Svejed
            </MudText>
            <MudText Typo="Typo.body2">
                8
            </MudText>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Class="mt-3 d-block mx-auto">
                Detalji
            </MudButton>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4" Elevation="2">
            <MudImage Src="images/otter.jpg"
                      Alt="Otter Image"
                      Fluid="true"
                      Class="mb-3" />
            <MudText Typo="Typo.h5">
                Vidra
            </MudText>
            <MudText Typo="Typo.h6">
                Lutra lutra
            </MudText>
            <MudText Typo="Typo.body1">
                Poluvodeni sisavac poznat po izvrsnom plivanju i gustom krznu koje ga štiti od hladnoće.
            </MudText>
            <MudText Typo="Typo.body2">
                10–15 godina
            </MudText>
            <MudText Typo="Typo.body2">
                Mesojed
            </MudText>
            <MudText Typo="Typo.body2">
                3
            </MudText>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Class="mt-3 d-block mx-auto">
                Detalji
            </MudButton>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4" Elevation="2">
            <MudImage Src="images/sheep.jpg"
                      Alt="Sheep Image"
                      Fluid="true"
                      Class="mb-3" />
            <MudText Typo="Typo.body2">
                      Ovca
            </MudText>
            <MudText Typo="Typo.h6">
                Ovis aries
            </MudText>
            <MudText Typo="Typo.body1">
                Domaća životinja koja se uzgaja zbog vune, mesa i mlijeka. Živi u stadima.
            </MudText>
            <MudText Typo="Typo.body2">
                10–12 godina
            </MudText>
            <MudText Typo="Typo.body2">
                Biljojed
            </MudText>
            <MudText Typo="Typo.body2">
                12
            </MudText>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Class="mt-3 d-block mx-auto">
                Detalji
            </MudButton>
        </MudPaper>
    </MudItem>
</MudGrid>

